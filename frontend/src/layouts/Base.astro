---
/* LIVE-DOC:START — alvs-feedlot-campo live-doc; see [[adr-17-live-doc-backlinks]]
 * Governed by: [[adr-52-frontend-and-design-system]]
 * Docs: [[FRONTEND]]
 * LIVE-DOC:END */
import "../styles/app.css";
import { parseThemeConfig, computeThemeSSRAttrs } from "$lib/theme";
import PageTitle from "$lib/components/primitives/titles/PageTitle.svelte";
import ChatDrawer from "$lib/components/shell/ChatDrawer.svelte";
import { hasRole } from "$lib/auth";
import { routerChatCopy } from "$lib/chatui-copy";
import type { Me } from "$lib/types/user";

interface Props {
  title?: string;
  /** The session the page already resolved from `/api/me/`. The layout uses it
   * for one thing: whether the router drawer is mounted at all. */
  me?: Me | null;
  /** Set by /chatui/, whose whole canvas already IS the router surface. */
  chatDrawer?: boolean;
}

const {
  title = process.env.PUBLIC_PROJECT_SLUG ?? "astro-drf-aws",
  me = null,
  chatDrawer = true,
} = Astro.props;

const publicBackendUrl = process.env.PUBLIC_BACKEND_URL ?? "http://localhost:8000";

// SSR, no-flash theme apply ("Persistence across login — no flash";
// [[DESIGN-SYSTEM]]): the `theme` cookie — set by the backend on login and
// on a successful `PATCH /api/me/` ([[API]]) — is parsed and sanitized here,
// server-side, before the first byte renders.
const themeBlob = parseThemeConfig(Astro.cookies.get("theme")?.value);
const { htmlClass, dataBgPreset, style } = computeThemeSSRAttrs(themeBlob);
---

<!doctype html>
<html lang="en" class={htmlClass} data-bg-preset={dataBgPreset} style={style}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <PageTitle title={title} />
  </head>
  <body>
    <slot />

    {
      /* Role-gated: a session with no Group is confined to the lobby
         ([[adr-20-authorization-lobby]] rule 1) and the router would answer it
         nothing. Mounted once here so every gated page carries the same
         surface — not duplicated per page. */
      chatDrawer && hasRole(me) && (
        <ChatDrawer client:load publicBackendUrl={publicBackendUrl} copy={routerChatCopy()} />
      )
    }

    <script>

      import "htmx.org";
    </script>
  </body>
</html>
