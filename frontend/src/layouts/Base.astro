---
/* LIVE-DOC:START — alvs-feedlot-campo live-doc; see [[adr-17-live-doc-backlinks]]
 * Governed by: [[adr-52-frontend-and-design-system]]
 * Docs: [[FRONTEND]]
 * LIVE-DOC:END */
import "../styles/app.css";
import { ClientRouter } from "astro:transitions";
import { parseThemeConfig, computeThemeSSRAttrs, DEFAULTS } from "$lib/theme";
import PageTitle from "$lib/components/primitives/titles/PageTitle.svelte";
import FeedlotFancyNav from "$lib/components/feedlot/FeedlotFancyNav.svelte";
import ChatDrawer from "$lib/components/shell/ChatDrawer.svelte";
import NavPendingBar from "$lib/components/shell/NavPendingBar.svelte";
import { resolveShellNav } from "$lib/components/shell/nav";
import { parseNavLockCookie } from "$lib/components/shell/nav-fsm";
import { hasRole } from "$lib/auth";
import { routerChatCopy } from "$lib/chatui-copy";
import type { Me } from "$lib/types/user";

/** Temporary: hide the right-edge router ChatDrawer while left-menu work lands. */
const SHOW_CHAT_DRAWER = false;

interface Props {
  title?: string;
  /** Session from `/api/me/` — gates site chrome (left FancyNav + right ChatDrawer). */
  me?: Me | null;
  /** Set false on /chatui/ (canvas already IS the router). Ignored while SHOW_CHAT_DRAWER is false. */
  chatDrawer?: boolean;
  /** Set false to suppress the left site menu. Default: on for any session
   * that has a role ([[adr-54-site-menu-lock-modes]] rule 3). */
  shellNav?: boolean;
}

const {
  title = process.env.PUBLIC_PROJECT_SLUG ?? "astro-drf-aws",
  me = null,
  chatDrawer = true,
  shellNav = true,
} = Astro.props;

const publicBackendUrl = process.env.PUBLIC_BACKEND_URL ?? "http://localhost:8000";

// SSR, no-flash theme apply ("Persistence across login — no flash";
// [[DESIGN-SYSTEM]]): the `theme` cookie — set by the backend on login and
// on a successful `PATCH /api/me/` ([[API]]) — is parsed and sanitized here,
// server-side, before the first byte renders.
const themeBlob = parseThemeConfig(Astro.cookies.get("theme")?.value);
const { htmlClass, dataBgPreset, style } = computeThemeSSRAttrs(themeBlob);
const sidebarSide = themeBlob.sidebarSide ?? DEFAULTS.sidebarSide;

const { active: navActive, clientId: navClientId } = resolveShellNav(
  Astro.url.pathname,
  Astro.url.searchParams,
);

// Lock preference from `nav_lock` cookie — same no-flash class as `theme`
// ([[adr-54-site-menu-lock-modes]]). Viewport band is CSS on first paint.
const navPreference = parseNavLockCookie(Astro.cookies.get("nav_lock")?.value);

// A session with a role always gets the site menu ([[adr-54-site-menu-lock-modes]]
// rule 3 — the menu is never invisible). The client is per-link data, never a
// precondition for the chrome: without one, client-scoped hrefs simply carry no
// `?client=`.
const showShellNav = shellNav && hasRole(me);
const showChatDrawer = SHOW_CHAT_DRAWER && chatDrawer && hasRole(me);
---

<!doctype html>
<html
  lang="en"
  class={htmlClass}
  data-bg-preset={dataBgPreset}
  style={style}
  transition:animate="none"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <PageTitle title={title} />
    <ClientRouter />
  </head>
  <body>
    <div class="flex min-h-screen">
      {
        showShellNav && (
          <FeedlotFancyNav
            transition:persist="shell-nav-island"
            transition:animate="none"
            client:load
            active={navActive}
            clientId={navClientId}
            preference={navPreference}
            side={sidebarSide}
            groups={me?.groups ?? []}
          />
        )
      }
      {/* No view-transition-name here: a named page-main snapshot is
          full-bleed over the fixed FancyDrawer strip and covers the menu
          during ClientRouter navigation. Feedback is CSS-only via
          html[data-nav-pending] on this pane (app.css). */}
      <div class="min-w-0 flex-1" data-page-main>
        <slot />
      </div>
    </div>

    {
      /* Role-gated router surface ([[CHATBOT]], adr-15). Hidden temporarily
         via SHOW_CHAT_DRAWER while left-menu work is in progress. */
      showChatDrawer && (
        <ChatDrawer
          transition:persist="shell-chat-island"
          transition:animate="none"
          client:load
          publicBackendUrl={publicBackendUrl}
          copy={routerChatCopy()}
        />
      )
    }

    {/* Visible during ClientRouter preparation (SSR fetch) — dim + top bar
        while HTML arrives; no named page-main view-transition snapshot. */}
    <NavPendingBar />

    <script>
      import "htmx.org";
    </script>
    <script>
      function setNavPending(pending: boolean) {
        if (pending) document.documentElement.dataset.navPending = "";
        else delete document.documentElement.dataset.navPending;
      }
      document.addEventListener("astro:before-preparation", () => setNavPending(true));
      document.addEventListener("astro:after-swap", () => setNavPending(false));
      document.addEventListener("astro:page-load", () => setNavPending(false));
    </script>
  </body>
</html>
