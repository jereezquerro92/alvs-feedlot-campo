---
/* LIVE-DOC:START — alvs-feedlot-campo live-doc; see [[adr-17-live-doc-backlinks]]
 * Governed by: [[adr-52-frontend-and-design-system]] · [[adr-44-field-operational-roles]] · [[adr-20-authorization-lobby]] · [[adr-35-conversational-assistant]] · [[adr-53-api-membrane]]
 * Docs: [[FRONTEND]]
 * API: [[API]]
 * LIVE-DOC:END */
import Base from "../../layouts/Base.astro";
import { AsesorModuleView } from "$lib/components/views";
import SessionBadge from "$lib/components/auth/SessionBadge.svelte";
import { hasRole, isPortalSession } from "$lib/auth";
import { requireRole, requireClientScope, portalLanding } from "$lib/authGate";
import { t } from "../../i18n";
import type { Me } from "$lib/types/user";
import { ssrFetch } from "$lib/ssrFetch";

const backendApiUrl = process.env.BACKEND_API_URL ?? "http://localhost:8000";
const publicBackendUrl = process.env.PUBLIC_BACKEND_URL ?? "http://localhost:8000";

const cookie = Astro.request.headers.get("cookie");
const headers: Record<string, string> = cookie ? { cookie } : {};

let me: Me | null = null;
if (cookie) {
  try {
    const res = await ssrFetch(`${backendApiUrl}/api/me/`, { headers });
    if (res.ok) me = (await res.json()) as Me;
  } catch (err) {
    console.error("SSR /api/me/ failed:", err);
  }
}

const redirect = requireRole(me);
if (redirect) return Astro.redirect(redirect);

async function getJson(path: string): Promise<any> {
  try {
    const res = await ssrFetch(`${backendApiUrl}${path}`, { headers });
    if (!res.ok) return null;
    return await res.json();
  } catch (err) {
    console.error(`SSR ${path} failed:`, err);
    return null;
  }
}

const asArray = (d: unknown): any[] =>
  Array.isArray(d) ? d : ((d as any)?.results ?? []);

const clientParam = Astro.url.searchParams.get("client");

// A lot-owner portal session may only reach its own client (adr-44 decision 3,
// adr-27 rule 2): gate the requested client id before rendering the advisor.
if (clientParam) {
  const scoped = requireClientScope(me, clientParam);
  if (scoped) return Astro.redirect(scoped);
}

let clients: any[] = [];
let currentClient: any = null;

if (isPortalSession(me)) {
  // The portal session is confined to its bound client and is 403'd on the
  // roster (`/api/clients/…`); its own client rides on `me.client` instead
  // (adr-44 decision 4). An unbound portal session is bounced to the lobby.
  const landing = portalLanding(me);
  if (landing && !me?.client) return Astro.redirect(landing);
  if (me?.client) {
    currentClient = { id: me.client.id, name: me.client.name, kind: me.client.kind };
    clients = [currentClient];
  }
} else {
  // Staff: the full roster feeds the switcher; the requested client is fetched.
  clients = asArray(await getJson(`/api/clients/`));
  if (clientParam) {
    currentClient = await getJson(`/api/clients/${clientParam}/`);
  }
}

const pending = me !== null && !hasRole(me);

Astro.response.headers.set("Cache-Control", "no-store");
---

<Base title={t("feedlot_module_asesor_title")} me={me}>
  <AsesorModuleView
    client:load
    clients={clients}
    currentClient={currentClient}
    publicBackendUrl={publicBackendUrl}
  >
    <SessionBadge
      client:load
      me={me}
      pending={pending}
      publicBackendUrl={publicBackendUrl}
      loginLabel={t("auth_login")}
      logoutLabel={t("auth_logout")}
      slot="session"
    />
  </AsesorModuleView>
</Base>
