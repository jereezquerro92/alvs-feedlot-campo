---
/* LIVE-DOC:START — alvs-feedlot-campo live-doc; see [[adr-17-live-doc-backlinks]]
 * Governed by: [[adr-52-frontend-and-design-system]] · [[adr-44-field-operational-roles]] · [[adr-20-authorization-lobby]]
 * Docs: [[FRONTEND]]
 * LIVE-DOC:END */
import Base from "../../../layouts/Base.astro";
import { FeedlotScheduleView } from "$lib/components/views";
import SessionBadge from "$lib/components/auth/SessionBadge.svelte";
import { hasRole } from "$lib/auth";
import { requireRole, denyPortalSession } from "$lib/authGate";
import { t } from "../../../i18n";
import type { Me } from "$lib/types/user";
import { ssrFetch } from "$lib/ssrFetch";

const backendApiUrl = process.env.BACKEND_API_URL ?? "http://localhost:8000";
const publicBackendUrl = process.env.PUBLIC_BACKEND_URL ?? "http://localhost:8000";

const { id } = Astro.params;
const cookie = Astro.request.headers.get("cookie");
const headers: Record<string, string> = cookie ? { cookie } : {};

let me: Me | null = null;
if (cookie) {
  try {
    const res = await ssrFetch(`${backendApiUrl}/api/me/`, { headers });
    if (res.ok) me = (await res.json()) as Me;
  } catch (err) {
    console.error("SSR /api/me/ failed:", err);
  }
}

// Lobby gate ([[adr-20-authorization-lobby]] rule 1).
const redirect = requireRole(me);
if (redirect) return Astro.redirect(redirect);

// Sanitary scheduling is an ops surface; a read-only lot-owner portal session is
// sent back to its own dashboard (adr-44 decision 3). Staff → null.
const denied = denyPortalSession(me);
if (denied) return Astro.redirect(denied);

async function getJson(path: string): Promise<any> {
  try {
    const res = await ssrFetch(`${backendApiUrl}${path}`, { headers });
    if (!res.ok) return null;
    return await res.json();
  } catch (err) {
    console.error(`SSR ${path} failed:`, err);
    return null;
  }
}

const client = await getJson(`/api/clients/${id}/`);
// An unknown client id bounces back to the clients list, not a broken page.
if (!client) return Astro.redirect("/feedlot/");

const [schedule, plansData, animalsData, lotsData] = await Promise.all([
  getJson(`/api/plan-enrollments/schedule/?client=${id}`),
  getJson(`/api/sanitary-plans/`),
  getJson(`/api/animals/?client=${id}`),
  getJson(`/api/lots/?client=${id}`),
]);

const asArray = (d: unknown): any[] =>
  Array.isArray(d) ? d : ((d as any)?.results ?? []);

const plans = asArray(plansData);
const animals = asArray(animalsData);
const lots = asArray(lotsData);
const today = new Date().toISOString().slice(0, 10);

const pending = me !== null && !hasRole(me);

Astro.response.headers.set("Cache-Control", "no-store");
---

<Base title={`${client.name} · ${t("feedlot_schedule_title")}`}>
  <FeedlotScheduleView
    client={client}
    schedule={schedule}
    plans={plans}
    animals={animals}
    lots={lots}
    today={today}
    publicBackendUrl={publicBackendUrl}
  >
    <SessionBadge
      client:load
      me={me}
      pending={pending}
      publicBackendUrl={publicBackendUrl}
      loginLabel={t("auth_login")}
      logoutLabel={t("auth_logout")}
      slot="session"
    />
  </FeedlotScheduleView>
</Base>
