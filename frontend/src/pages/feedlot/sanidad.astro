---
/* LIVE-DOC:START — alvs-feedlot-campo live-doc; see [[adr-17-live-doc-backlinks]]
 * Governed by: [[adr-52-frontend-and-design-system]] · [[adr-44-field-operational-roles]] · [[adr-20-authorization-lobby]] · [[adr-53-api-membrane]]
 * Docs: [[FRONTEND]]
 * API: [[API]]
 * LIVE-DOC:END */
import Base from "../../layouts/Base.astro";
import { FeedlotModuleView } from "$lib/components/views";
import SessionBadge from "$lib/components/auth/SessionBadge.svelte";
import { hasRole } from "$lib/auth";
import { requireRole, denyPortalSession } from "$lib/authGate";
import { t } from "../../i18n";
import type { Me } from "$lib/types/user";
import { ssrFetch } from "$lib/ssrFetch";

const backendApiUrl = process.env.BACKEND_API_URL ?? "http://localhost:8000";
const publicBackendUrl = process.env.PUBLIC_BACKEND_URL ?? "http://localhost:8000";

const cookie = Astro.request.headers.get("cookie");
const headers: Record<string, string> = cookie ? { cookie } : {};

let me: Me | null = null;
if (cookie) {
  try {
    const res = await ssrFetch(`${backendApiUrl}/api/me/`, { headers });
    if (res.ok) me = (await res.json()) as Me;
  } catch (err) {
    console.error("SSR /api/me/ failed:", err);
  }
}

const redirect = requireRole(me);
if (redirect) return Astro.redirect(redirect);
const denied = denyPortalSession(me);
if (denied) return Astro.redirect(denied);

async function getJson(path: string): Promise<any> {
  try {
    const res = await ssrFetch(`${backendApiUrl}${path}`, { headers });
    if (!res.ok) return null;
    return await res.json();
  } catch (err) {
    console.error(`SSR ${path} failed:`, err);
    return null;
  }
}

const asArray = (d: unknown): any[] =>
  Array.isArray(d) ? d : ((d as any)?.results ?? []);

const clientParam = Astro.url.searchParams.get("client");
const [
  clientsData,
  currentClient,
  animalsData,
  lotsData,
  healthProductsData,
  plansData,
  scheduleData,
] = await Promise.all([
  getJson(`/api/clients/`),
  clientParam ? getJson(`/api/clients/${clientParam}/`) : Promise.resolve(null),
  clientParam ? getJson(`/api/animals/?client=${clientParam}`) : Promise.resolve(null),
  clientParam ? getJson(`/api/lots/?client=${clientParam}`) : Promise.resolve(null),
  getJson(`/api/health-products/`),
  getJson(`/api/sanitary-plans/`),
  clientParam
    ? getJson(`/api/plan-enrollments/schedule/?client=${clientParam}`)
    : Promise.resolve(null),
]);
const clients = asArray(clientsData);
const animals = currentClient ? asArray(animalsData) : [];
const lots = currentClient ? asArray(lotsData) : [];
const healthProducts = asArray(healthProductsData);
const plans = asArray(plansData);
const schedule = currentClient ? scheduleData : null;

const today = new Date().toISOString().slice(0, 10);
const pending = me !== null && !hasRole(me);

Astro.response.headers.set("Cache-Control", "no-store");
---

<Base title={t("feedlot_module_health_title")} me={me}>
  <FeedlotModuleView
    client:load
    module="health"
    navKey="sanitary"
    slug="sanidad"
    clients={clients}
    currentClient={currentClient}
    animals={animals}
    lots={lots}
    healthProducts={healthProducts}
    plans={plans}
    schedule={schedule}
    today={today}
    publicBackendUrl={publicBackendUrl}
  >
    <SessionBadge
      client:load
      me={me}
      pending={pending}
      publicBackendUrl={publicBackendUrl}
      loginLabel={t("auth_login")}
      logoutLabel={t("auth_logout")}
      slot="session"
    />
  </FeedlotModuleView>
</Base>
