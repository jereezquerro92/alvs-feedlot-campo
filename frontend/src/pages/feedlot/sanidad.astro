---
/* LIVE-DOC:START — alvs-feedlot-campo live-doc; see [[adr-17-live-doc-backlinks]]
 * Governed by: [[adr-52-frontend-and-design-system]] · [[adr-44-field-operational-roles]] · [[adr-20-authorization-lobby]] · [[adr-53-api-membrane]]
 * Docs: [[FRONTEND]]
 * API: [[API]]
 * LIVE-DOC:END */
import Base from "../../layouts/Base.astro";
import { FeedlotModuleView } from "$lib/components/views";
import SessionBadge from "$lib/components/auth/SessionBadge.svelte";
import { hasRole } from "$lib/auth";
import { requireRole, denyPortalSession } from "$lib/authGate";
import { t } from "../../i18n";
import type { Me } from "$lib/types/user";

const backendApiUrl = process.env.BACKEND_API_URL ?? "http://localhost:8000";
const publicBackendUrl = process.env.PUBLIC_BACKEND_URL ?? "http://localhost:8000";

const cookie = Astro.request.headers.get("cookie");
const headers: Record<string, string> = cookie ? { cookie } : {};

let me: Me | null = null;
if (cookie) {
  try {
    const res = await fetch(`${backendApiUrl}/api/me/`, { headers });
    if (res.ok) me = (await res.json()) as Me;
  } catch (err) {
    console.error("SSR /api/me/ failed:", err);
  }
}

const redirect = requireRole(me);
if (redirect) return Astro.redirect(redirect);
const denied = denyPortalSession(me);
if (denied) return Astro.redirect(denied);

async function getJson(path: string): Promise<any> {
  try {
    const res = await fetch(`${backendApiUrl}${path}`, { headers });
    if (!res.ok) return null;
    return await res.json();
  } catch (err) {
    console.error(`SSR ${path} failed:`, err);
    return null;
  }
}

const asArray = (d: unknown): any[] =>
  Array.isArray(d) ? d : ((d as any)?.results ?? []);

const clientParam = Astro.url.searchParams.get("client");
const clients = asArray(await getJson(`/api/clients/`));

let currentClient: any = null;
let animals: any[] = [];
let lots: any[] = [];
let healthProducts: any[] = [];
let plans: any[] = [];
let schedule: any = null;
if (clientParam) {
  currentClient = await getJson(`/api/clients/${clientParam}/`);
  if (currentClient) {
    const [animalsData, lotsData, healthProductsData, plansData, scheduleData] =
      await Promise.all([
        getJson(`/api/animals/?client=${clientParam}`),
        getJson(`/api/lots/?client=${clientParam}`),
        getJson(`/api/health-products/`),
        getJson(`/api/sanitary-plans/`),
        getJson(`/api/plan-enrollments/schedule/?client=${clientParam}`),
      ]);
    animals = asArray(animalsData);
    lots = asArray(lotsData);
    healthProducts = asArray(healthProductsData);
    plans = asArray(plansData);
    schedule = scheduleData;
  }
}

const today = new Date().toISOString().slice(0, 10);
const pending = me !== null && !hasRole(me);

Astro.response.headers.set("Cache-Control", "no-store");
---

<Base title={t("feedlot_module_health_title")}>
  <FeedlotModuleView
    client:load
    module="health"
    navKey="sanitary"
    slug="sanidad"
    clients={clients}
    currentClient={currentClient}
    animals={animals}
    lots={lots}
    healthProducts={healthProducts}
    plans={plans}
    schedule={schedule}
    today={today}
    publicBackendUrl={publicBackendUrl}
  >
    <SessionBadge
      client:load
      me={me}
      pending={pending}
      publicBackendUrl={publicBackendUrl}
      loginLabel={t("auth_login")}
      logoutLabel={t("auth_logout")}
      slot="session"
    />
  </FeedlotModuleView>
</Base>
