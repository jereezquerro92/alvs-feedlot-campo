---
/* LIVE-DOC:START — alvs-feedlot-campo live-doc; see [[adr-17-live-doc-backlinks]]
 * Governed by: [[adr-52-frontend-and-design-system]] · [[adr-44-field-operational-roles]] · [[adr-20-authorization-lobby]] · [[adr-53-api-membrane]]
 * Docs: [[FRONTEND]]
 * API: [[API]]
 * LIVE-DOC:END */
import Base from "../../layouts/Base.astro";
import { FeedlotClientsView } from "$lib/components/views";
import { hasRole } from "$lib/auth";
import { requireRole, portalLanding } from "$lib/authGate";
import { t } from "../../i18n";
import type { Me } from "$lib/types/user";
import { ssrFetch } from "$lib/ssrFetch";

const backendApiUrl = process.env.BACKEND_API_URL ?? "http://localhost:8000";
const publicBackendUrl = process.env.PUBLIC_BACKEND_URL ?? "http://localhost:8000";

const cookie = Astro.request.headers.get("cookie");
const headers: Record<string, string> = cookie ? { cookie } : {};

let me: Me | null = null;
if (cookie) {
  try {
    const res = await ssrFetch(`${backendApiUrl}/api/me/`, { headers });
    if (res.ok) me = (await res.json()) as Me;
  } catch (err) {
    console.error("SSR /api/me/ failed:", err);
  }
}

// The lobby gate ([[adr-20-authorization-lobby]] rule 1): a role-less session is
// bounced to `/` with a reason, never shown the gated surface.
const redirect = requireRole(me);
if (redirect) return Astro.redirect(redirect);

// A lot-owner portal session never sees the roster: send it straight to its own
// client dashboard, or the lobby if unbound (adr-44 decisions 3–4). Staff → null.
const portal = portalLanding(me);
if (portal) return Astro.redirect(portal);

let clients: any[] = [];
try {
  const res = await ssrFetch(`${backendApiUrl}/api/clients/`, { headers });
  if (res.ok) {
    const data = await res.json();
    clients = Array.isArray(data) ? data : (data.results ?? []);
  }
} catch (err) {
  console.error("SSR /api/clients/ failed:", err);
}

const pending = me !== null && !hasRole(me);

// The Graph status words ([[adr-13-m365-graph]] rule 3 — both routes are
// AllowAny, so no cookie is forwarded). A failure degrades to its status code
// rather than blanking the strip or breaking the roster render.
async function fetchWord(path: string): Promise<string> {
  try {
    const res = await ssrFetch(`${backendApiUrl}${path}`);
    const text = await res.text();
    return res.ok ? text : String(res.status);
  } catch {
    return "error";
  }
}

const [m365Hello, m365World] = await Promise.all([
  fetchWord("/api/m365/hello/"),
  fetchWord("/api/m365/world/"),
]);

Astro.response.headers.set("Cache-Control", "no-store");
---

<Base title={t("feedlot_clients_title")}>
  <FeedlotClientsView
    client:load
    clients={clients}
    publicBackendUrl={publicBackendUrl}
    me={me}
    pending={pending}
    m365Hello={m365Hello}
    m365World={m365World}
  />
</Base>
