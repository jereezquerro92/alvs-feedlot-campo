 * API: [[API]]
 * LIVE-DOC:END */
import Base from "../layouts/Base.astro";
import { ChatView } from "$lib/components/views";
import ChatUI from "$lib/components/chat/ChatUI.svelte";
import { requireRole } from "$lib/authGate";
import { t } from "../i18n";
import { routerChatCopy } from "$lib/chatui-copy";
import type { Me } from "$lib/types/user";
import { ssrFetch } from "$lib/ssrFetch";

const backendApiUrl = process.env.BACKEND_API_URL ?? "http://localhost:8000";
const publicBackendUrl = process.env.PUBLIC_BACKEND_URL ?? "http://localhost:8000";

let me: Me | null = null;
const cookie = Astro.request.headers.get("cookie");
if (cookie) {
  try {
    const res = await ssrFetch(`${backendApiUrl}/api/me/`, { headers: { cookie } });
    if (res.ok) me = (await res.json()) as Me;
  } catch (err) {
    console.error("SSR /api/me/ failed:", err);
  }
}

const redirect = requireRole(me);
if (redirect) return Astro.redirect(redirect);

Astro.response.headers.set("Cache-Control", "no-store");
---

<Base title={t("nav_chatui")} me={me} chatDrawer={false}>
  <ChatView>
    <ChatUI client:load publicBackendUrl={publicBackendUrl} copy={routerChatCopy()} />
  </ChatView>
</Base>
