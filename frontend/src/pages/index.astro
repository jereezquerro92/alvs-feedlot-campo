---
/* LIVE-DOC:START — alvs-feedlot-campo live-doc; see [[adr-17-live-doc-backlinks]]
 * Governed by: [[adr-52-frontend-and-design-system]] · [[adr-20-authorization-lobby]] · [[adr-10-auth]] · [[adr-53-api-membrane]]
 * Docs: [[FRONTEND]]
 * API: [[API]]
 * LIVE-DOC:END */
import Base from "../layouts/Base.astro";
import { LoginLandingView } from "$lib/components/views";
import SessionBadge from "$lib/components/auth/SessionBadge.svelte";
import { hasRole } from "$lib/auth";
import { DENIED_QUERY } from "$lib/authGate";
import { t } from "../i18n";
import type { Me } from "$lib/types/user";
import { ssrFetch } from "$lib/ssrFetch";

const backendApiUrl = process.env.BACKEND_API_URL ?? "http://localhost:8000";
const publicBackendUrl = process.env.PUBLIC_BACKEND_URL ?? "http://localhost:8000";
const publicProjectSlug = process.env.PUBLIC_PROJECT_SLUG ?? "astro-drf-aws";

let me: Me | null = null;
const cookie = Astro.request.headers.get("cookie");
if (cookie) {
  try {
    const res = await ssrFetch(`${backendApiUrl}/api/me/`, { headers: { cookie } });
    if (res.ok) me = (await res.json()) as Me;
  } catch (err) {
    console.error("SSR /api/me/ failed:", err);
  }
}

// The landing IS the login (redesign): a session that already holds a role skips
// the landing entirely and goes straight to the feedlot — no intermediate
// feedlot/showcase/chat menu. Only an anonymous or role-less (pending) session
// stays here to sign in / wait for a grant ([[adr-20-authorization-lobby]]).
if (hasRole(me)) return Astro.redirect("/feedlot/");

const pending = me !== null;
const denied = Astro.url.searchParams.get(DENIED_QUERY) === "1";

Astro.response.headers.set("Cache-Control", "no-store");
---

<Base title={t("login_title")} me={me}>
  <LoginLandingView
    projectSlug={publicProjectSlug}
    publicBackendUrl={publicBackendUrl}
    pending={pending}
    denied={denied}
    loginLabel={t("auth_login")}
  >
    <SessionBadge
      client:load
      me={me}
      pending={pending}
      publicBackendUrl={publicBackendUrl}
      loginLabel={t("auth_login")}
      logoutLabel={t("auth_logout")}
      slot="session"
    />
  </LoginLandingView>
</Base>
