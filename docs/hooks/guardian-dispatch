#!/usr/bin/env python3
"""guardian-dispatch — the dispatch safety net (adr-03 rules 3 and 8).

Maps a batch of changed files against the `watch:` globs each agent declares
in the frontmatter of its definition under docs/agents/, and names the
guardians the owner process must dispatch before the batch closes. The
`watch:` key is the single machine copy of every watchlist (adr-03 rule 8);
this script only reads it — it never carries a list of its own.

Runtime-agnostic on purpose: git + python3 stdlib, nothing else. Any agent
harness (or human) can call it; docs/hooks/pre-commit speaks it at commit
time.

Usage:
  guardian-dispatch            batch = working tree vs HEAD, plus untracked
  guardian-dispatch --staged   batch = staged files only (pre-commit)
  guardian-dispatch <ref>      batch = files changed since <ref>

Exit 0: no guardian owed. Exit 1: dispatch owed (named on stdout).
Globs are fnmatch-style; `*` crosses `/`, so `docs/adrs/*` covers nesting.
"""

from __future__ import annotations

import subprocess
import sys
from fnmatch import fnmatch
from pathlib import Path


def repo_root() -> Path:
    out = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        capture_output=True, text=True, check=True,
    )
    return Path(out.stdout.strip())


def git_lines(*args: str) -> list[str]:
    out = subprocess.run(
        ["git", *args], capture_output=True, text=True, check=True,
    )
    return [line for line in out.stdout.splitlines() if line.strip()]


def changed_files(argv: list[str]) -> list[str]:
    if "--staged" in argv:
        return git_lines("diff", "--name-only", "--cached")
    refs = [a for a in argv if not a.startswith("-")]
    if refs:
        return git_lines("diff", "--name-only", refs[0])
    tracked = git_lines("diff", "--name-only", "HEAD")
    untracked = git_lines("ls-files", "--others", "--exclude-standard")
    return sorted(set(tracked + untracked))


def watchlists(agents_dir: Path) -> dict[str, list[str]]:
    """Parse `watch:` from each agent definition's frontmatter."""
    lists: dict[str, list[str]] = {}
    for path in sorted(agents_dir.glob("*.md")):
        lines = path.read_text(encoding="utf-8").splitlines()
        if not lines or lines[0].strip() != "---":
            continue
        globs: list[str] = []
        in_watch = False
        for line in lines[1:]:
            if line.strip() == "---":
                break
            if line.startswith("watch:"):
                in_watch = True
                continue
            if in_watch:
                stripped = line.strip()
                if stripped.startswith("- "):
                    globs.append(stripped[2:].strip().strip("'\""))
                else:
                    in_watch = False
        if globs:
            lists[path.stem] = globs
    return lists


def main(argv: list[str]) -> int:
    root = repo_root()
    files = changed_files(argv)
    if not files:
        print("guardian-dispatch: empty batch — no guardian owed.")
        return 0

    owed: dict[str, list[str]] = {}
    for guardian, globs in watchlists(root / "docs" / "agents").items():
        hits = [f for f in files if any(fnmatch(f, g) for g in globs)]
        if hits:
            owed[guardian] = hits

    if not owed:
        print(f"guardian-dispatch: {len(files)} file(s) in batch — no guardian owed.")
        return 0

    print(f"guardian-dispatch: {len(owed)} guardian(s) owed for this batch (adr-03 rule 3)")
    for guardian, hits in sorted(owed.items()):
        shown = ", ".join(hits[:4]) + (f", +{len(hits) - 4} more" if len(hits) > 4 else "")
        print(f"  -> {guardian} — {len(hits)} file(s): {shown}")
    print("Dispatch each before the batch closes; violation/danger blocks (adr-03 rule 5).")
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
