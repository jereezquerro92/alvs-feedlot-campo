
PROJECT_SLUG=astro-drf-aws
BASE_DOMAIN=grupoalvs.com

DB_HOST=db
DB_PORT=5432
DB_NAME=app
DB_USER=app
DB_PASSWORD=app

DB_PUBLISH_PORT=5432

COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=
COGNITO_REGION=us-east-1
AUTH_DEV_MODE=true
AUTH_BOOTSTRAP_ALLOWLIST=dev@example.com:admins

# Post-login / post-logout destination. The settings default is `/`, correct in
# cloud where one ALB origin serves both services; locally they sit on split
# ports, so both point at the frontend origin.
LOGIN_REDIRECT_URL=http://localhost:4321/
LOGOUT_REDIRECT_URL=http://localhost:4321/

MSGRAPH_TENANT_ID=
MSGRAPH_CLIENT_ID=
MSGRAPH_CLIENT_SECRET=

SECRET_KEY=dev-insecure-not-for-cloud
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:4321
CORS_ALLOWED_ORIGINS=http://localhost:4321
BACKEND_PUBLISH_PORT=8000
UVICORN_WORKERS=4

HOST=0.0.0.0
PORT=4321
NODE_ENV=production
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_BACKEND_URL=http://localhost:8000
BACKEND_API_URL=http://backend:8000
FRONTEND_PUBLISH_PORT=4321

