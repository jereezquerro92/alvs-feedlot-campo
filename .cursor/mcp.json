{
  "mcpServers": {
    "markdown-vault-docs": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/mvmcp.py",
        "serve"
      ],
      "env": {
        "MARKDOWN_VAULT_MCP_EXCLUDE": "agents/**,hooks/**,skills/**",
        "MARKDOWN_VAULT_MCP_PROFILE": "keyword"
      }
    }
  }
}
